{
  "manifest_version": 3,
  "name": "Unqlock",
  "version": "1.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "description": "Color-codes Unqork builder components, shows which environment you are on, and adds debug tools for submission data.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-32.png",
        "popup.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Unqlock"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.unqork.io/ide/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.unqork.io/*"
      ],
      "js": [
        "environment.js",
        "environment-badge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
