{
  "manifest_version": 3,
  "name": "Unqlock",
  "version": "1.0.2",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "description": "Recognizable component colors and distinct icons in the UnqorkAI builder. Follows light and dark appearance.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Unqlock"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.unqork.io/ide/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
